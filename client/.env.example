# --- Local development ---
# Optional: override the Vite proxy target (defaults to http://localhost:1500)
# VITE_API_PROXY_TARGET=http://localhost:1500

# Optional: override where /v1/api/expenses is proxied (defaults to http://localhost:4004)
# VITE_EXPENSE_API_PROXY_TARGET=http://localhost:4004

# Point both at the gateway instead to exercise the production path locally:
# VITE_API_PROXY_TARGET=http://localhost:4000
# VITE_EXPENSE_API_PROXY_TARGET=http://localhost:4000

# --- Production (Vercel) ---
# The gateway is the ONLY origin the client talks to. It proxies /v1/api/*
# to the monolith, /v1/api/expenses/* to expense-service, and /socket.io to
# the monolith's Socket.IO server — so one URL covers REST and real-time.
# VITE_API_URL=https://<your-gateway>.onrender.com/v1/api

# NOTE: do not point the client at expense-service (or the monolith) directly.
# They require the gateway's x-internal-secret header and will answer 403.
