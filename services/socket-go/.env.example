# Server
PORT=1600
NODE_ENV=development

# Comma-separated browser origins allowed for Socket.IO CORS
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000

# Same names as chat-service — copy its values. NODE_ENV=development uses the DEV_* ones.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/messaging
REDIS_URL=
REDIS_PORT=
REDIS_PASSWORD=

DEV_MONGODB_URI=mongodb://127.0.0.1:27017/messaging
DEV_REDIS_URL=127.0.0.1
DEV_REDIS_PORT=6379
DEV_REDIS_PASSWORD=

# Must be identical to chat-service and expense-service
JWT_SECRET=

# Firebase Admin — optional; without it offline push notifications are skipped
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# Must match the gateway. When set, only requests carrying it may open a socket.
# Leave unset locally only if Vite talks to :1600 directly.
INTERNAL_SECRET=
