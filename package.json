{
  "name": "messaging-server",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time messaging server with authentication",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w services/chat-service",
    "build": "npm run build -w services/chat-service",
    "start": "npm start -w services/chat-service",
    "dev:services": "concurrently -n chat,socket,gateway,expense -c magenta,yellow,blue,cyan \"npm:dev -w services/chat-service\" \"cd services/socket-go && go run ./cmd/server\" \"cd services/gateway && go run ./cmd/server\" \"npm:dev -w services/expense-service\"",
    "build:services": "npm run build --workspaces --if-present"
  },
  "keywords": [
    "messaging-server",
    "socket.io",
    "real-time",
    "chat"
  ],
  "author": "Kyaw-Min-Khant",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
